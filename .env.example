# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
REDIS_URL=redis://127.0.0.1:6379

# ─── Shopify (custom app installed in the Sura Books store) ─────────────────
SHOPIFY_SHOP_DOMAIN=surabooks.myshopify.com
SHOPIFY_API_SECRET=                 # signs webhooks AND App Proxy requests
SHOPIFY_ADMIN_TOKEN=                # shpat_... Admin API access token
SHOPIFY_API_VERSION=2025-07

# ─── SMSIntegra (SMS) ───────────────────────────────────────────────────────
SMS_ENABLED=true
SMS_BASE_URL=https://www.smsintegra.net/api/smsapipost.aspx
SMS_GET_BASE_URL=https://www.smsintegra.com/api/smsapi.aspx
SMS_CREDIT_URL=https://www.smsintegra.com/api/creditcheck.aspx
SMS_DLR_URL=https://www.smsintegra.com/api/deliveryreport.aspx
SMS_UID=
SMS_PWD=
SMS_SENDER_ID=                      # max 6 chars, DLT-approved
SMS_ENTITY_ID=                      # DLT principal entity id
# Vendor docs disagree on POST field names (msg/txt, dtTimeNow/dtNow).
# Confirm with SMSIntegra support, then set these. See README "Open questions".
SMS_POST_TEXT_FIELD=txt
SMS_POST_TIME_FIELD=dtNow

# ─── ChatIntegra (WhatsApp) ─────────────────────────────────────────────────
WA_ENABLED=true
WA_BASE_URL=https://smsintegraapi-babqbpczh9cag8hy.centralindia-01.azurewebsites.net/api/WhatsAppMessage
WA_CREDIT_URL=https://www.smsintegra.net/api/wacreditcheck.aspx
WA_UID=
WA_PWD=
WA_INBOUND_SECRET=                  # shared secret for ChatIntegra -> us callbacks

# ─── DLT / WhatsApp template ids ────────────────────────────────────────────
DLT_TMPL_REGISTRATION_OTP=
DLT_TMPL_ORDER_CONFIRMATION=
DLT_TMPL_DELIVERY_OTP=
WA_TMPL_ORDER_CONFIRMATION=
WA_TMPL_SHIPPING_UPDATE=

# ─── OTP policy ─────────────────────────────────────────────────────────────
OTP_SECRET=                         # 32+ random bytes, used to hash OTPs
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
